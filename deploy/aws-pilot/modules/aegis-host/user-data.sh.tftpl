#!/usr/bin/env bash
# BlueDefence pilot host bootstrap (cloud-init user-data). Runs once on first boot; log: /var/log/bluedefence-bootstrap.log
# No secret is baked into this file: the ingest token and the console admin password are generated here and
# stored in SSM Parameter Store (SecureString) under /bluedefence/<name>/ — see `terraform output secrets`.
set -euo pipefail
install -m 600 /dev/null /var/log/bluedefence-bootstrap.log
exec > >(tee -a /var/log/bluedefence-bootstrap.log) 2>&1
export DEBIAN_FRONTEND=noninteractive

DOMAIN='${domain}'
LICENSE_SERVER='${license_server}'
BRANCH='${aegis_branch}'
NAME='${name}'
BACKUP_BUCKET='${backup_bucket}'
export AWS_DEFAULT_REGION="$(curl -fsS --max-time 3 -H "X-aws-ec2-metadata-token: $(curl -fsS --max-time 3 -X PUT -H 'X-aws-ec2-metadata-token-ttl-seconds: 60' http://169.254.169.254/latest/api/token)" http://169.254.169.254/latest/meta-data/placement/region)"
gen() { head -c 24 /dev/urandom | base64 | tr -d '/+=' | cut -c1-32; }
umask 077
export AEGIS_INGEST_TOKEN="$(gen)"                 # read by install.sh from the environment, never from argv
CONSOLE_ADMIN_PW="$(gen)"
umask 022

echo "▸ packages"
apt-get update -q
apt-get install -y -q git python3 python3-venv python3-pip nginx certbot python3-certbot-nginx curl jq

echo "▸ AEGIS (shadow mode, Community licence)"
curl -fsSL "https://raw.githubusercontent.com/mahi80/BlueDefence/$BRANCH/install.sh" -o /root/install.sh
AEGIS_BRANCH="$BRANCH" bash /root/install.sh --non-interactive --yes \
  --community --org '${community_org}' --email '${community_email}' --server "$LICENSE_SERVER" \
  --sources stream --ingest-bind 127.0.0.1:8787 \
  --branch "$BRANCH"

echo "▸ analyst console (local sign-in)"
curl -fsSL https://deb.nodesource.com/setup_20.x | bash -
apt-get install -y -q nodejs
cd /opt/aegis/app/soc-console
npm ci --no-audit --no-fund
npm run build
install -d -o aegis -g aegis -m 750 /var/lib/aegis/console
install -m 640 -o root -g aegis /dev/null /etc/aegis/console.env
cat > /etc/aegis/console.env <<EOF
# analyst console — local accounts until the bank's IdP is wired (AEGIS_AUTH_MODE=oidc)
AEGIS_AUTH_MODE=local
AEGIS_CONSOLE_USERS=/var/lib/aegis/console/users.json
AEGIS_CONSOLE_SECRET=$(head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n')
# the host's own API (served by the push receiver from the audit chain + HITL files)
AEGIS_API_ORIGIN=http://127.0.0.1:8787
AEGIS_API_KEY=$(grep '^AEGIS_CONSOLE_TOKEN=' /etc/aegis/aegis.env | cut -d= -f2-)
PORT=3000
HOSTNAME=127.0.0.1
EOF
AEGIS_CONSOLE_USERS=/var/lib/aegis/console/users.json AEGIS_USER_PASSWORD="$CONSOLE_ADMIN_PW" \
  sudo -u aegis --preserve-env=AEGIS_CONSOLE_USERS,AEGIS_USER_PASSWORD node scripts/users.mjs add admin admin
# the build output is served read-only; only the image/data cache may be written
install -d -o aegis -g aegis -m 750 /opt/aegis/app/soc-console/.next/cache
cat > /etc/systemd/system/aegis-console.service <<'EOF'
[Unit]
Description=BlueDefence analyst console
After=network-online.target aegis-soc.service
Wants=network-online.target

[Service]
User=aegis
Group=aegis
WorkingDirectory=/opt/aegis/app/soc-console
EnvironmentFile=/etc/aegis/console.env
ExecStart=/usr/bin/npm run start
Restart=always
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=no
SystemCallArchitectures=native
CapabilityBoundingSet=
UMask=0077
ReadWritePaths=/var/lib/aegis/console /opt/aegis/app/soc-console/.next/cache

[Install]
WantedBy=multi-user.target
EOF
systemctl daemon-reload
systemctl enable --now aegis-console

echo "▸ nginx (http now; https once the certificate is issued)"
cat > /etc/nginx/sites-available/aegis <<EOF
server_tokens off;
server {
    listen 80;
    server_name $DOMAIN;
    client_max_body_size 32m;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy same-origin always;

    # forwarders → push receiver. /healthz is public but answers only ok/degraded without the read token.
    location /ingest/ { proxy_pass http://127.0.0.1:8787; proxy_read_timeout 60s; }
    location = /healthz { proxy_pass http://127.0.0.1:8787; }
    location = /metrics { allow 127.0.0.1; deny all; proxy_pass http://127.0.0.1:8787; }

    # analyst console
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$remote_addr;
        proxy_set_header X-Forwarded-Proto \$scheme;
    }
}
EOF
ln -sf /etc/nginx/sites-available/aegis /etc/nginx/sites-enabled/aegis
rm -f /etc/nginx/sites-enabled/default
nginx -t && systemctl reload nginx

echo "▸ TLS: retry certbot until $DOMAIN resolves to this host"
cat > /usr/local/bin/aegis-tls <<EOF
#!/usr/bin/env bash
# issue the Let's Encrypt certificate once DNS points here; the timer calls this every 5 min until it succeeds
set -u
me=\$(curl -fsS --max-time 5 https://checkip.amazonaws.com | tr -d '[:space:]')
got=\$(getent ahostsv4 "$DOMAIN" | awk 'NR==1{print \$1}')
if [[ -z "\$got" || "\$got" != "\$me" ]]; then echo "waiting: $DOMAIN -> \$got, this host is \$me"; exit 0; fi
n=\$(cat /var/lib/aegis/tls-attempts 2>/dev/null || echo 0); n=\$((n+1)); echo "\$n" > /var/lib/aegis/tls-attempts
if certbot --nginx --non-interactive --agree-tos -m '${letsencrypt_email}' -d "$DOMAIN" --redirect --hsts; then
  systemctl disable --now aegis-tls.timer; rm -f /var/lib/aegis/tls-attempts; exit 0
fi
# Let's Encrypt allows 5 failed validations per hour: back off, and give up after 12 so a misconfiguration is visible
if [[ \$n -ge 12 ]]; then echo "TLS: giving up after \$n failed attempts — fix DNS/port 80/CAA and run: systemctl enable --now aegis-tls.timer" >&2; systemctl disable --now aegis-tls.timer; exit 1; fi
exit 1
EOF
chmod 755 /usr/local/bin/aegis-tls
cat > /etc/systemd/system/aegis-tls.service <<'EOF'
[Unit]
Description=BlueDefence TLS issuance (runs until the certificate exists)
[Service]
Type=oneshot
ExecStart=/usr/local/bin/aegis-tls
EOF
cat > /etc/systemd/system/aegis-tls.timer <<'EOF'
[Unit]
Description=Retry TLS issuance every 5 minutes
[Timer]
OnBootSec=2min
OnUnitActiveSec=15min
[Install]
WantedBy=timers.target
EOF
systemctl daemon-reload
systemctl enable --now aegis-tls.timer
/usr/local/bin/aegis-tls || true

echo "▸ WAF log puller (CloudWatch Logs → /ingest/waf every 30 s)"
/opt/aegis/venv/bin/pip install -q boto3
cat > /usr/local/bin/aegis-cwlogs-pull <<'PYEOF'
${cwlogs_pull_py}
PYEOF
chmod 755 /usr/local/bin/aegis-cwlogs-pull
install -m 640 -o root -g aegis /dev/null /etc/aegis/cwlogs.env
cat > /etc/aegis/cwlogs.env <<EOF
AEGIS_CWLOGS_GROUP=${waf_log_group}
AEGIS_CWLOGS_REGION=us-east-1
AEGIS_INGEST_URL=http://127.0.0.1:8787
AEGIS_INGEST_TOKEN=$(grep '^AEGIS_INGEST_TOKEN=' /etc/aegis/aegis.env | cut -d= -f2-)
AEGIS_CWLOGS_CHECKPOINT=/var/lib/aegis/cwlogs-checkpoint.json
EOF
cat > /etc/systemd/system/aegis-cwlogs.service <<'EOF'
[Unit]
Description=BlueDefence: pull AWS WAF events from CloudWatch Logs
After=aegis-soc.service
[Service]
Type=oneshot
User=aegis
Group=aegis
EnvironmentFile=/etc/aegis/cwlogs.env
ExecStart=/usr/local/bin/aegis-cwlogs-pull
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/aegis
EOF
cat > /etc/systemd/system/aegis-cwlogs.timer <<'EOF'
[Unit]
Description=Pull WAF events every 30 s
[Timer]
OnBootSec=90s
OnUnitActiveSec=30s
AccuracySec=5s
[Install]
WantedBy=timers.target
EOF
systemctl daemon-reload
systemctl enable --now aegis-cwlogs.timer

echo "▸ daily backup (audit chain, licence, state) → /var/backups/aegis and s3://$BACKUP_BUCKET"
cat > /etc/cron.daily/aegis-backup <<EOF
#!/usr/bin/env bash
# the host is disposable; the evidence is not. Local copy + S3 (versioned bucket, 90-day lifecycle).
[[ -x /usr/local/bin/aegis-backup ]] || exit 0
out=\$(/usr/local/bin/aegis-backup /var/backups/aegis 2>/dev/null | grep -o '/var/backups/aegis/[^ ]*\.tar\.gz' | tail -1)
find /var/backups/aegis -name '*.tar.gz' -mtime +14 -delete 2>/dev/null
[[ -n "\$out" ]] && /opt/aegis/venv/bin/python - "\$out" <<'PY'
import sys, boto3, os
boto3.client("s3").upload_file(sys.argv[1], "$BACKUP_BUCKET", "$NAME/" + os.path.basename(sys.argv[1]))
PY
EOF
chmod 755 /etc/cron.daily/aegis-backup

echo "▸ secrets → SSM Parameter Store (/bluedefence/$NAME/*)"
/opt/aegis/venv/bin/python - <<PY
import boto3
ssm = boto3.client("ssm")
for name, val in (("console-admin-password", """$CONSOLE_ADMIN_PW"""), ("ingest-token", """$AEGIS_INGEST_TOKEN"""),
                  ("console-token", open("/etc/aegis/aegis.env").read().split("AEGIS_CONSOLE_TOKEN=")[1].split("\n")[0].strip())):
    ssm.put_parameter(Name=f"/bluedefence/$NAME/{name}", Value=val, Type="SecureString", Overwrite=True)
print("stored")
PY
unset CONSOLE_ADMIN_PW AEGIS_INGEST_TOKEN

echo "✓ bootstrap done — $(date -u +%FT%TZ)"
curl -fsS http://127.0.0.1:8787/healthz | jq -c . || true
