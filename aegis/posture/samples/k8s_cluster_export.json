    {
     "apiGroups": [
      ""
     ],
     "resources": [
      "pods/exec"
     ],
     "verbs": [
      "create"
     ]
    }
   ]
  },
  {
   "kind": "RoleBinding",
   "metadata": {
    "name": "support",
    "namespace": "payments"
   },
   "roleRef": {
    "kind": "Role",
    "name": "support-debug"
   },
   "subjects": [
