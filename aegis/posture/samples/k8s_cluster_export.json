   "metadata": {
    "name": "ops-everything"
   },
   "rules": [
    {
     "apiGroups": [
      "*"
     ],
     "resources": [
      "*"
     ],
     "verbs": [
      "*"
     ]
    }
   ]
  },
  {
   "kind": "ClusterRoleBinding",
   "metadata": {
    "name": "ops-team"
   },
   "roleRef": {
    "kind": "ClusterRole",
    "name": "ops-everything"
   },
   "subjects": [
    {
