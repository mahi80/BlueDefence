    "namespace": "kube-system"
   },
   "spec": {
    "template": {
     "spec": {
      "hostNetwork": true,
      "containers": [
       {
        "name": "kp",
        "image": "k8s/kube-proxy:v1.30.1",
        "securityContext": {
         "privileged": true
        }
       }
      ]
     }
    }
   }
  },
  {
   "kind": "ClusterRoleBinding",
   "metadata": {
    "name": "ci-admin"
   },
   "roleRef": {
    "kind": "ClusterRole",
    "name": "cluster-admin"
   },
   "subjects": [
    {
     "kind": "ServiceAccount",
     "name": "ci-deployer",
     "namespace": "batch"
    }
   ]
  },
  {
   "kind": "ClusterRoleBinding",
   "metadata": {
