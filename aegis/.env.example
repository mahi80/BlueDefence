# Copy to .env (or export directly) before running with a real LLM.
# Without ANTHROPIC_API_KEY set, the system falls back to MockClient.

# ANTHROPIC_API_KEY=sk-ant-...
# LLM_BACKEND=anthropic   # auto | anthropic | mock

# --- Model-call bounds ---
# One request timeout (s). The Anthropic SDK default was 600 s, which stalled the
# serial pipeline for ten minutes on a hung connection.
# AEGIS_LLM_TIMEOUT_S=60
# Wall clock for the whole call including retries (s).
# AEGIS_LLM_DEADLINE_S=90
# Consecutive failures before the breaker opens, and how long it stays open (s).
# While open every call raises immediately and the alert takes the uncertain+HITL path.
# AEGIS_LLM_BREAKER_FAILURES=5
# AEGIS_LLM_BREAKER_RESET_S=30

# --- Enforcement (roadmap Phase 1) ---
# shadow (default): connectors record what they would do, no vendor calls. live: real calls.
AEGIS_ENFORCEMENT_MODE=shadow
# Two-person rule: block/isolate/kill_process/rotate_credential on these targets needs a second approver.
# CIDRs for IP targets, globs for names. Empty = rule off.
AEGIS_PROTECTED_TARGETS=
