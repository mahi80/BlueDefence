# ---- backend ----
# Origin of the ACP dashboard FastAPI backend the console reads/writes.
# Leave empty to run fully on bundled fixtures (dev/CI, no backend needed).
AEGIS_API_ORIGIN=
# When "1", the data layer serves bundled fixtures instead of calling the backend.
# Defaults to on when AEGIS_API_ORIGIN is empty.
NEXT_PUBLIC_AEGIS_USE_FIXTURES=
# Optional bearer for server-side reads of api-key-gated routes.
AEGIS_API_KEY=
# Optional: endpoint of the LLM-backed "Agent Q" chat (the one the ACP dashboard runs).
# When set, the Ask-Agent-Q mascot forwards free-text questions there (with the detection as
# context). Leave empty and Q answers deterministically from the chain itself (no LLM needed).
AEGIS_ASK_URL=
# Q's own key (never the backend key above, which can approve actions).
AEGIS_ASK_KEY=
# Behind a reverse proxy that rewrites Host: the public origin(s) of this console.
AEGIS_CONSOLE_ORIGIN=
# Change to sign every session out.
AEGIS_SESSION_EPOCH=

# ---- auth ----
# demo = local id+password (below). oidc = single sign-on to the bank IdP.
AEGIS_AUTH_MODE=demo
# Must match AEGIS_AUTH_MODE; picks the login screen (client-visible).
NEXT_PUBLIC_AEGIS_AUTH_MODE=demo
# HMAC secret for the session cookie. SET A STRONG VALUE IN PRODUCTION.
AEGIS_CONSOLE_SECRET=
# Demo credentials (demo mode only). Not for production.
AEGIS_DEMO_USER=soc
AEGIS_DEMO_PASSWORD=demo
AEGIS_DEMO_ROLE=bu_head

# ---- production SSO (AEGIS_AUTH_MODE=oidc) ----
# From your IdP's OIDC discovery (Entra ID / Okta / Ping / ADFS). The callback's
# verified id_token handling is wired at deployment (see docs/deploy/onprem-bank.md).
AEGIS_CONSOLE_URL=
AEGIS_OIDC_AUTHORIZE_URL=
AEGIS_OIDC_TOKEN_URL=
AEGIS_OIDC_CLIENT_ID=
AEGIS_OIDC_REDIRECT_URI=
AEGIS_OIDC_SCOPE=openid profile email groups
# Map IdP group -> AEGIS role: "group-admins:admin,soc-leads:bu_head,soc-analysts:analyst"
AEGIS_OIDC_ROLE_MAP=
